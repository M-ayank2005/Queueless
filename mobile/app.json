{
  "expo": {
    "name": "QueueLess Mobile",
    "slug": "queueless-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050B18"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "package": "com.anonymous.queuelessmobile"
    },
    "plugins": [
      "expo-camera",
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050B18",
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:5000/api"
    }
  }
}
