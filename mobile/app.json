{
  "expo": {
    "name": "QueueLess Mobile",
    "slug": "queueless-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "QueueLess uses the camera to scan store QR codes"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#284D83"
      },
      "permissions": [
        "CAMERA"
      ],
      "package": "com.anonymous.queuelessmobile"
    },
    "plugins": [
      "expo-camera",
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#284D83",
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:5000/api"
    }
  }
}
